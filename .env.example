OPENAI_API_KEY=YOUR_API_KEY
OPENAI_BASE_URL=YOUR_BASE_URL

MILVUS_URI=YOUR_MILVUS_URL
MILVUS_TOKEN=YOUR_MILVUS_TOKEN
MILVUS_DB_NAME=YOUR_DB_NAME

# -----------------------------
# Optional (reference) pipeline params
# You can change these to fit your environment.
# -----------------------------
LIGHTGPT_MODEL=gpt-4o-mini
NON_DIAGRAM_CAPTION_MODEL=gpt-4o
DIAGRAM_CAPTION_MODEL=gpt-5
DIAGRAM_THRESHOLD=0.65
CAPTION_MAX_TOKENS=1200

EMBEDDING_MODEL=text-embedding-3-large-model
EMBEDDING_OUT_DIM=3072
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_NLIST=128
MILVUS_NPROBE=10
MILVUS_TEXT_MAX_LENGTH=32768
EMBED_BATCH_SIZE=64
EMBED_MAX_CHARS=8000
MILVUS_INSERT_BATCH_ROWS=2000